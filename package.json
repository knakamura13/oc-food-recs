{
	"name": "oc-food-recs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:pipeline": "python3 -m unittest tests/test_reddit_pipeline.py tests/test_dedupe_logic.py tests/test_geocode_normalization.py tests/test_exclusions.py tests/test_reingest_all_threads.py",
		"test:all": "npm test && npm run test:pipeline",
		"test:e2e:ci": "playwright test",
		"pipeline:geocode-health": "python3 scripts/geocode_health.py",
		"pipeline:audit-comment-dates": "python3 scripts/audit_comment_dates.py",
		"pipeline:backfill-comment-dates": "python3 scripts/backfill_comment_dates.py",
		"pipeline:backfill-permalinks": "python3 scripts/backfill_permalinks.py",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"pipeline:init:thread-01": "python3 scripts/reddit_pipeline.py init-thread --html tests/fixtures/thread-01.html",
		"pipeline:init:thread-02": "python3 scripts/reddit_pipeline.py init-thread --html tests/fixtures/thread-02.html",
		"pipeline:build:thread-01": "python3 scripts/reddit_pipeline.py build-thread --thread orangecounty-1sb0qo7",
		"pipeline:build:thread-02": "python3 scripts/reddit_pipeline.py build-thread --thread orangecounty-1slszch",
		"pipeline:seed-exclusions": "python3 scripts/seed_exclusions.py",
		"pipeline:apply-exclusions": "python3 scripts/apply_exclusions.py",
		"test": "vitest run",
		"test:watch": "vitest"
	},
    "dependencies": {
		"@tanstack/virtual-core": "^3.13.12",
		"@vincjo/datatables": "^2.8.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"fuse.js": "^7.3.0",
		"leaflet": "^1.9.4",
		"leaflet.markercluster": "^1.5.3",
        "svelte-sonner": "^1.1.1",
		"lucide-svelte": "^1.0.1",
		"pg": "^8.21.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/leaflet": "^1.9.21",
		"@types/leaflet.markercluster": "^1.5.6",
		"@types/node": "^25.6.0",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^27.4.0",
		"playwright": "^1.59.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "^4.22.3",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
        "vitest": "^4.1.8"
	}
}
