# Postgres connection string (Railway provides this on the Postgres service > Connect tab)
# Format: postgresql://user:password@host:port/db_name
DATABASE_URL=

# Ollama for the entity-extraction step (local dev only — Railway doesn't run Ollama)
# Prefixed names are canonical; unprefixed OLLAMA_* aliases are also accepted.
OC_FOOD_RECS_OLLAMA_URL=http://127.0.0.1:11434/api/chat
OC_FOOD_RECS_OLLAMA_MODEL=gemma4:latest
# Disable chain-of-thought on reasoning models: true | false | omit (default: false)
OC_FOOD_RECS_OLLAMA_THINK=false

# When set on Railway, /admin/* routes are guarded by Basic Auth instead of returning 404.
# Leave unset in production to keep admin routes unreachable.
ADMIN_PASSWORD=

# Google Places API (New) — used by the Python ingest pipeline and admin geocode corrections.
GOOGLE_MAPS_API_KEY=
